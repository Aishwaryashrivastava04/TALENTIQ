<?xml version="1.0" encoding="UTF-8"?>
<!-- ========================================================================= -->
<!-- MODULE V: JAVA SERVER TECHNOLOGIES - DEPLOYMENT DESCRIPTOR (web.xml)     -->
<!-- Course Code: CSIT751 (Core Java) - Amity University                        -->
<!-- Demonstrates Servlet Declaration, Servlet Mapping, and URL Routing        -->
<!-- ========================================================================= -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>TALENTIQ Enterprise Recruitment Web Application</display-name>

    <context-param>
        <param-name>applicationName</param-name>
        <param-value>TALENTIQ Smart Recruitment Platform</param-value>
    </context-param>

    <!-- 1. Servlet Declaration -->
    <servlet>
        <servlet-name>CandidateAPIServlet</servlet-name>
        <servlet-class>servlet.CandidateServlet</servlet-class>
        <init-param>
            <param-name>organization</param-name>
            <param-value>TALENTIQ Enterprise</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- 2. Servlet URL Mapping -->
    <servlet-mapping>
        <servlet-name>CandidateAPIServlet</servlet-name>
        <url-pattern>/api/candidates/*</url-pattern>
    </servlet-mapping>

    <!-- 3. Welcome File List -->
    <welcome-file-list>
        <welcome-file>candidates.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- 4. Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
