# ============================================================================
# Smart Recruitment Backend Environment Configuration
# ============================================================================

PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=mca_smart_recruitment_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# MySQL Relational Database (Subject 4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_recruitment_db
DB_CONNECTION_LIMIT=10

# MongoDB Document Database
MONGO_URI=mongodb://127.0.0.1:27017/smart_recruitment_docs

# Microservices Network Endpoints
FLASK_ML_SERVICE_URL=http://127.0.0.1:5001
JAVA_SERVICE_URL=http://127.0.0.1:5002

# File Ingestion
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
